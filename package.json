{
  "name": "pi-hot-compact",
  "version": "0.2.0",
  "description": "Hot compaction and context compiler for the pi coding agent: background compaction over an immutable event log, atomic context swap, recall of omitted history",
  "license": "MIT",
  "type": "module",
  "main": "index.ts",
  "files": ["index.ts", "src/"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheetahbyte/pi-hot-compact.git"
  },
  "homepage": "https://github.com/cheetahbyte/pi-hot-compact#readme",
  "bugs": {
    "url": "https://github.com/cheetahbyte/pi-hot-compact/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "compaction",
    "context"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit",
    "prepublishOnly": "bun test && bun run typecheck"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.0 <1.0.0",
    "typebox": ">=1.0.0 <2.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
